{
  "manifest_version": 3,
  "name": "SUCA",
  "version": "0.1.0",
  "description": "Registra la interacción, la mirada y los movimientos faciales durante pruebas de usabilidad.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "SUCA"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "config.generated.js",
        "common/platform.js",
        "common/clock.js",
        "common/messages.js",
        "common/session.js",
        "common/batcher.js",
        "content/capture.js",
        "content/camera.js",
        "content/calibration.js",
        "content/task-end.js",
        "content/bootstrap.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
