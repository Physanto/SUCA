{
  "manifest_version": 3,
  "name": "SUCA",
  "version": "0.1.0",
  "description": "Registra la interacción, la mirada y los movimientos faciales durante pruebas de usabilidad.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "SUCA"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "config.generated.js",
        "common/platform.js",
        "common/clock.js",
        "common/messages.js",
        "common/session.js",
        "common/batcher.js",
        "common/modules.js",
        "content/capture.js",
        "camera/strings.js",
        "content/camera/zones.js",
        "content/camera.js",
        "content/calibration.js",
        "content/task-end.js",
        "content/bootstrap.js"
      ]
    }
  ]
}
